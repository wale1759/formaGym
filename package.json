{
  "name": "forma-fitness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently --names frontend,backend \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace backend"
  },
  "devDependencies": { "concurrently": "^9.1.0" }
}
